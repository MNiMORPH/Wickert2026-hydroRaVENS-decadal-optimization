# Dakota input file: hydroRaVENS Le Sueur River parameter calibration
# Generated by generate_dakota_in.py from params.yml — do not edit by hand.
#
# Active parameters (8):
#   log__t_recession_soil: log10 soil-zone recession time scale [days]
#   log__t_recession_intermediate: log10 intermediate recession time scale [days]
#   log__t_recession_deep: log10 deep groundwater recession time scale [days]
#   f_exfiltration_soil: fraction of soil-zone drainage to stream (remainder recharges intermediate)
#   f_exfiltration_intermediate: fraction of intermediate drainage to stream (remainder recharges deep)
#   PDD_melt_factor: degree-day snowmelt rate [mm SWE / degC / day]
#   recession_b_soil: power-law recession exponent for soil zone [dimensionless]
#   log__fdd_threshold: log10 frozen-ground-index threshold [degC·day]; blocks infiltration when exceeded
# Fixed (inactive) parameters:
#   recession_b_intermediate = 2.203  (intermediate recession exponent fixed at 2.203 (Brutsaert-Nieber lower envelope))
#   snow_insulation_k = 0.0  (snow insulation decay constant [mm⁻¹ SWE] — fixed at 0 (no insulation))
#   et_scale = 1.0  (global ET multiplier — inactive (water balance enforced globally))
#   et_alpha = 1.0  (ET partition fraction — fixed at 1.0 (all ET from soil))
#   f_direct_runoff = 0.0  (fast-bypass fraction of daily recharge — inactive)
#   baseflow_Q = 0.0  (constant regional groundwater import [mm/day] — inactive)
#   log__routing_K = 0.0  (log10 Nash-cascade storage time constant [days] — inactive)

environment
  top_method_pointer = 'HYBRID'
  tabular_data
    tabular_data_file = 'dakota.dat'

method
  id_method = 'HYBRID'
  hybrid sequential
    method_pointer_list = 'EGO' 'PS'

method
  id_method = 'EGO'
  efficient_global
    gaussian_process surfpack
    initial_samples = 300
    seed = 12345
    output quiet
  model_pointer = 'M1'

method
  id_method = 'PS'
  coliny_pattern_search
    max_function_evaluations = 200
    convergence_tolerance = 0.0001
    output quiet
  model_pointer = 'M1'

model
  id_model = 'M1'
  single
    interface_pointer = 'I1'
  variables_pointer = 'V1'
  responses_pointer = 'R1'

variables
  id_variables = 'V1'
  continuous_design = 8
    descriptors   = 'log__t_recession_soil' 'log__t_recession_intermediate' 'log__t_recession_deep' 'f_exfiltration_soil' 'f_exfiltration_intermediate' 'PDD_melt_factor' 'recession_b_soil' 'log__fdd_threshold'
    lower_bounds  =  1.0  1.0  3.5  0.01  0.01  0.1  1.5  0.0
    upper_bounds  =  4.5  4.5  5.0  0.99  0.99  10.0  6.0  3.0
    initial_point =  4.493  1.021  3.771  0.6662  0.012  7.8611  5.4907  2.502

interface
  id_interface = 'I1'
  analysis_driver = 'bash run_driver.sh'
  fork
    parameters_file = 'params.in'
    results_file    = 'results.out'
    work_directory
      named 'out/run'
      directory_tag
      directory_save
    file_save
    copy_files 'driver.py' 'le_sueur_config_1935_2024.yml' '/home/awickert/dataanalysis/Wickert2026-hydroRaVENS-decadal-optimization/db.out.hydroravens/examples/le_sueur_river/le_sueur_forcing.csv' 'run_driver.sh' 'decades/1941-1950//params.yml'
    asynchronous
      evaluation_concurrency = 4

responses
  id_responses = 'R1'
  objective_functions = 1
    response_descriptors = 'neg_kge'
  no_gradients
  no_hessians
